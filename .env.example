# ---- Vapi (https://dashboard.vapi.ai) ----
# Private key: Dashboard -> Settings -> API Keys. Used by scripts/ and the server.
VAPI_PRIVATE_KEY=
# Public key: same page. Safe to expose to the browser; used for web calls.
VAPI_PUBLIC_KEY=
# Filled in by scripts/setup_assistant.py
VAPI_ASSISTANT_ID=
# Optional: only needed for real outbound phone calls (imported Twilio/Telnyx number)
VAPI_PHONE_NUMBER_ID=
# Optional: shared secret Vapi sends as x-vapi-secret on every webhook
VAPI_WEBHOOK_SECRET=change-me

# ---- Public URL of this server (ngrok) so Vapi can reach the tool webhooks ----
PUBLIC_BASE_URL=https://your-subdomain.ngrok-free.app

# ---- Model/voice routed through Vapi's own provider keys (covered by Vapi credits) ----
VAPI_MODEL_PROVIDER=openai
VAPI_MODEL=gpt-4.1-mini
VAPI_VOICE_PROVIDER=vapi
VAPI_VOICE_ID=Naina

# ---- Merchant branding used in the script ----
MERCHANT_NAME=StreamBox
AGENT_NAME=Asha

# ---- Compliance policy ----
CALL_WINDOW_START=09:00
CALL_WINDOW_END=20:00
CALL_TIMEZONE=Asia/Kolkata
MAX_ATTEMPTS=3
